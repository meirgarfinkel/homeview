{
  "name": "homeview",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "description": "HomeView: watch your home camera from any screen at home, and from away. No cloud.",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter @kasa/server --filter @kasa/web dev",
    "dev:fake-camera": "pnpm --filter @kasa/server fake-camera",
    "dev:fake-onvif": "pnpm --filter @kasa/server fake-onvif",
    "build": "pnpm -r build",
    "start": "pnpm --filter @kasa/server start",
    "desktop": "pnpm --filter @kasa/desktop start",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "discover": "pnpm --filter @kasa/server discover",
    "probe": "pnpm --filter @kasa/server probe",
    "setup-camera": "pnpm --filter @kasa/server setup-camera",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0"
  }
}
