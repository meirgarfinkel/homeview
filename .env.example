# Copy to .env and fill in. .env is git-ignored; never commit it.

# --- Camera (required) ---------------------------------------------------
# The email and password of the Kasa account the camera is registered to.
KASA_USERNAME=
KASA_PASSWORD=

# Camera IP. Leave empty (recommended): Kasa Home finds the camera on the
# network and follows it if its address changes. Set it only to pin one IP.
KASA_HOST=
# With several cameras, pick one by its name (as set in setup or the Kasa app).
KASA_ALIAS=

# The camera's clock and on-video timestamp follow this computer's time zone,
# re-checked hourly so daylight-saving changes are picked up. Set an IANA name
# (e.g. Europe/London) to use another zone, or KASA_SYNC_TIMEZONE=false to
# leave the camera's clock alone.
KASA_TIMEZONE=
KASA_SYNC_TIMEZONE=true

# auto (recommended) | md5 | base64. auto asks the camera which it expects.
KASA_PASSWORD_ENCODING=auto
# Stream resolution: 2560x1440 | 2304x1296 | 1080P | 720P | 360P. Empty = camera default.
KASA_STREAM_RESOLUTION=
# Optional: pin the camera's TLS certificate (`pnpm probe` prints it).
KASA_CERT_SHA256=

# --- Web server ----------------------------------------------------------
# 0.0.0.0 makes the page reachable from other devices on your network.
HOST=0.0.0.0
PORT=8090
# Password for the web page. Required (8+ characters) unless ALLOW_NO_PASSWORD=true.
VIEWER_PASSWORD=
ALLOW_NO_PASSWORD=false
# HTTPS is on by default with a self-signed certificate created in DATA_DIR.
# To use your own (e.g. from mkcert), set both files.
HTTPS=true
TLS_CERT_FILE=
TLS_KEY_FILE=
# Where generated secrets live (TLS key, session secret). Default: ./data
DATA_DIR=
# Optional; generated and stored in DATA_DIR when empty.
SESSION_SECRET=
# Extra hostnames allowed in the Host header (IPs, localhost and *.local always work).
ALLOWED_HOSTS=
# Which client networks may connect (CIDRs, comma separated).
# Default: this machine plus the LAN subnet it is on (not Docker/VPN networks).
ALLOWED_CIDRS=

# --- Behaviour -----------------------------------------------------------
# Close the camera stream this many seconds after the last viewer leaves.
IDLE_DISCONNECT_SECONDS=30
PTZ_ENABLED=true
# Pan/tilt speed for a tap, 1-10 (the camera rejects higher values). Holding a
# direction glides at the camera's own fixed speed.
PTZ_STEP_SPEED=2
LOG_LEVEL=info
