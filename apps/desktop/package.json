{
  "name": "@kasa/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Kasa Home: a LAN web viewer for Kasa cameras",
  "author": "Meir Garfinkel",
  "homepage": "https://github.com/meirgarfinkel/kasa-home",
  "type": "module",
  "main": "dist/main.mjs",
  "scripts": {
    "build": "tsup",
    "start": "pnpm build && electron dist/main.mjs",
    "dist": "pnpm --filter @kasa/tunnel build && pnpm build && electron-builder --publish never",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "electron": "45.5.0",
    "electron-builder": "^26.8.1",
    "pino": "^10.4.0",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1"
  }
}
